<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" page-range-format="minimal" default-locale="en-GB">
  <info>
    <title>Forestry, Oxford SCIMED author-date, after the journal's mini style checklist of October 2021</title>
    <id>http://www.zotero.org/styles/forestry-scimed-2026</id>
    <link href="https://academic.oup.com/forestry/pages/General_Instructions" rel="documentation"/>
    <summary>Written 2026-10-19 for deep-learn-alaska-spruce-beetle from the journal's style sheet: in-text (Smith 1994), several citations in date order separated by commas, reference list alphabetical with surname and unspaced initials, article as Journal Year;Volume:pages with elided page ranges, et al. in the list after three names as in the sheet's book example.</summary>
    <updated>2026-10-19T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en-GB">
    <terms>
      <term name="editor" form="short"><single>ed.</single><multiple>eds</multiple></term>
    </terms>
  </locale>
  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " delimiter-precedes-last="never" et-al-min="3" et-al-use-first="1"/>
      <et-al font-style="normal"/>
      <substitute><names variable="editor"/><text variable="title" form="short"/></substitute>
    </names>
  </macro>
  <macro name="author-long">
    <names variable="author">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never" delimiter-precedes-et-al="never" et-al-min="4" et-al-use-first="3"/>
      <et-al font-style="normal"/>
      <substitute><names variable="editor"/><text variable="title"/></substitute>
    </names>
  </macro>
  <macro name="editor">
    <names variable="editor">
      <name initialize-with="" name-as-sort-order="all" sort-separator=" " delimiter=", " delimiter-precedes-last="never"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="year">
    <group>
      <date variable="issued"><date-part name="year"/></date>
      <text variable="year-suffix"/>
    </group>
  </macro>
  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>
  <macro name="doi">
    <text variable="DOI" prefix="https://doi.org/"/>
  </macro>
  <macro name="access">
    <group delimiter=" ">
      <text variable="URL"/>
      <date variable="accessed" prefix="(" suffix=", date last accessed)">
        <date-part name="day" suffix=" "/><date-part name="month" suffix=" "/><date-part name="year"/>
      </date>
    </group>
  </macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true" collapse="year">
    <sort>
      <key macro="year"/>
      <key macro="author-short"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <group delimiter=" ">
        <text macro="author-short"/>
        <group delimiter=", ">
          <text macro="year"/>
          <group delimiter=" ">
            <label variable="locator" form="short"/>
            <text variable="locator"/>
          </group>
        </group>
      </group>
    </layout>
  </citation>
  <bibliography et-al-min="4" et-al-use-first="3" entry-spacing="0" hanging-indent="false">
    <sort>
      <key macro="author-long"/>
      <key macro="year"/>
    </sort>
    <layout suffix=".">
      <group delimiter=". ">
        <text macro="author-long"/>
        <choose>
          <if type="article-journal">
            <text variable="title"/>
            <group delimiter=" ">
              <text variable="container-title"/>
              <group delimiter=":">
                <group delimiter=";">
                  <text macro="year"/>
                  <text variable="volume"/>
                </group>
                <text variable="page"/>
              </group>
            </group>
            <text macro="doi"/>
          </if>
          <else-if type="chapter paper-conference" match="any">
            <text variable="title"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in" text-case="capitalize-first" suffix=":"/>
                <text macro="editor"/>
                <text variable="container-title" font-style="italic"/>
              </group>
              <text macro="publisher"/>
              <text macro="year"/>
              <text variable="page"/>
            </group>
            <text macro="doi"/>
          </else-if>
          <else-if type="report">
            <text variable="title"/>
            <group delimiter=" ">
              <text variable="genre"/>
              <text variable="number"/>
            </group>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="doi"/>
          </else-if>
          <else-if type="webpage dataset post-weblog" match="any">
            <text variable="title"/>
            <text macro="access"/>
          </else-if>
          <else>
            <text variable="title" font-style="italic"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="doi"/>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
